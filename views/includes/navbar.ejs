<style>
    .btn-search {
        background-color: #fe424d !important;
        color: #fff !important;
        border-radius: 25px !important;
        padding: 0 1rem 0 1rem !important;
    }

    .btn-search:hover {
        background-color: #fe424d !important;
        color: #fff !important;
    }

    .btn-search i {
        display: inline;
        margin-right: 0.5rem;
    }

    .search-input {
        border-radius: 25px !important;
        padding: 0.5rem 3rem 0.5rem 3rem !important;
        font-size: 1rem !important;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<nav class="navbar navbar-expand-md navbar-light bg-light border-bottom sticky-top">
    <div class="container-fluid">
        <!-- Brand -->
        <a class="navbar-brand" href="/">
            <i class="fa-solid fa-compass"></i>
        </a>

        <!-- Hamburger Button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapsible Content -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- Left side -->
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Explore</a>
            </div>

            <!-- Search form (center on desktop, stacked on mobile) -->
            <div class="navbar-nav ms-md-auto">
                <form class="d-flex my-2 my-md-0" role="search">
                    <input class="form-control me-2 search-input" type="search" placeholder="Search destination"
                        aria-label="Search" />
                    <button class="btn btn-search" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                </form>
            </div>

            <!-- Right side -->
            <div class="navbar-nav ms-md-auto">
                <a class="nav-link" href="/listings/new">Airbnb your home</a>
                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup"><b>SignUp</b></a>
                    <a class="nav-link" href="/login"><b>LogIn</b></a>
                <% } %>
                <% if(currUser) { %>
                    <a class="nav-link" href="/logout"><b>Logout</b></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ENjdO4Dr2bkBIFxQpeoE6VvM8FhB7xHkz1l3mq0c6tUOMHUZyZk3Feh4bR5pXWjQ"
    crossorigin="anonymous"></script>
